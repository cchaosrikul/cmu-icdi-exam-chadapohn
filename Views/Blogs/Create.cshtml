@model Blogs
@{
    ViewData["Title"] = "Create";
}


<h1>เพิ่มบทความ</h1>
<form method="POST" asp-controller="Blogs" asp-action="Create">
    <div class="form-group">
        <label asp-for="BlogTitle"></label>
        <input type="text" asp-for="BlogTitle" class="form-control" />
        <span asp-validation-for="BlogTitle" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="BlogContent"></label>
        <input type="text" asp-for="BlogContent" class="form-control" />
        <span asp-validation-for="BlogContent" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary my-2">บันทึก</button>
</form>

