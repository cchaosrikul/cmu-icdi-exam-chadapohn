@model IEnumerable<Blogs>

<h1>ค้นหาบทความ</h1>
<table class="table">
    <thead>
        <tr>
            <th></th>
            <th>หัวข้อ</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var entry in Model)
        {
            <tr>
                <td>รูปภาพ</td>
                <td>@entry.BlogTitle</td>
                <td>
                    <a class="btn btn-primary"
                       asp-controller="Blogs"
                       asp-action="Display"
                       asp-route-id=@entry.BlogId>รายละเอียด</a>
                    <a class="btn btn-warning"
                       asp-controller="Blogs"
                       asp-action="Edit"
                       asp-route-id=@entry.BlogId>แก้ไข</a>
                    <a class="btn btn-danger"
                       asp-controller="Blogs"
                       asp-action="Delete"
                       asp-route-id=@entry.BlogId
                       onclick="return confirm('ยืนยันการลบ @entry.BlogTitle')">ลบ</a>
                </td>
            </tr>
        }
    </tbody>
</table>